# -----------------------------------------------------------
#  [*] legalops-assistant — dev image
#
#  Bare node: compose bind-mounts assistant/app over /app, and
#  the entry installs the dependencies and runs nodemon — the
#  same dev loop as the vite container.
# -----------------------------------------------------------

FROM node:24.16.0

WORKDIR /app

ENV PORT=3000
EXPOSE 3000

CMD ["sh", "-c", "npm install && npm run dev"]
