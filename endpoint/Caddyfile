:80 {
    log {
        output stdout
        format json
    }
    encode zstd gzip



    route {

        # ------------------------------------------------------------
        #                         Security headers
        # ------------------------------------------------------------
        # SECURITY: Block other applications from accessing the application at the Caddy level
        @foreign expression `{http.request.header.Origin} != "" && !{http.request.header.Origin}.endsWith("://" + {http.request.host})`
        respond @foreign 403

        # SECURITY: Restricts the scripts in the browser from communicating with external sources
        header Content-Security-Policy "
            default-src         'self';
            script-src          'self' 'unsafe-inline' 'unsafe-eval';
            style-src           'self' 'unsafe-inline';
            img-src             'self' data:;
            font-src            'self' data:;
            connect-src         'self';
            frame-ancestors     'self';
            frame-src           'self';
            child-src           'self';
            form-action         'self';
            base-uri            'self';
            worker-src          'self';
            upgrade-insecure-requests;
        "

        # SECURITY: Force HTTPS for this domain
        header Strict-Transport-Security "max-age=31536000"

        # ------------------------------------------------------------
        # ------------------------------------------------------------
        # ------------------------------------------------------------



        # DBGate Endpoint
        redir /dbgate /dbgate/
        handle /dbgate/* {
            forward_auth legalops-django:8000 {
                uri /api/auth/checkauth/admin
            }
            reverse_proxy legalops-dbgate:3000 {
                header_up X-Forwarded-For {remote_host}
                header_up Authorization "Basic {env.DBGATE_AUTH_HEADER}"
            }
        }


        # Assistant
        handle /api/assistant/* {
            reverse_proxy legalops-assistant:3000 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                header_up X-Real-IP {http.request.header.X-Forwarded-For}
            }
        }


        # Django
        handle /api/* {
            reverse_proxy legalops-django:8000 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                header_up X-Real-IP {http.request.header.X-Forwarded-For}
            }
        }


        # Documentation
        redir /docs /docs/
        handle /docs/* {
            reverse_proxy legalops-docs:80
        }


        # Vite
        handle {
            reverse_proxy legalops-vite:80 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
                header_up X-Real-IP {http.request.header.X-Forwarded-For}
            }
        }



    }
}
